{
  "name": "typo-md-editor",
  "version": "0.1.0",
  "description": "纯前端 React WYSIWYG Markdown 编辑器组件（Milkdown/Crepe 内核，零原生运行时依赖）",
  "type": "module",
  "license": "MIT",
  "files": ["dist", "docs"],
  "sideEffects": ["*.css"],
  "main": "./dist/typo-md-editor.js",
  "module": "./dist/typo-md-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/typo-md-editor.js" },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build:lib": "tsc --noEmit && node scripts/prepare-build.cjs dist && vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "typecheck": "tsc --noEmit",
    "test": "node tests/build.mjs && node --test tests/.out/*.test.mjs",
    "postinstall": "node scripts/patch-milkdown-image-block.mjs",
    "patch:milkdown": "node scripts/patch-milkdown-image-block.mjs"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@floating-ui/dom": "^1.6.0",
    "@milkdown/core": "^7.0.0",
    "@milkdown/crepe": "^7.0.0",
    "@milkdown/preset-commonmark": "^7.0.0",
    "@milkdown/preset-gfm": "^7.0.0",
    "@milkdown/prose": "^7.0.0",
    "@milkdown/react": "^7.0.0",
    "@milkdown/theme-nord": "^7.0.0",
    "@milkdown/transformer": "^7.0.0",
    "@milkdown/utils": "^7.0.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.0",
    "mermaid": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rehype-highlight": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.21.0",
    "jsdom": "^30.1.2",
    "terser": "^5.51.2",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
